
<odoo>
    <!-- 1. GIAO DIEN DANH SACH EMAIL -->
    <record id="view_email_phishing_check_list" model="ir.ui.view">
        <field name="name">email.phishing.check.list</field>
        <field name="model">email.phishing.check</field>
        <field name="arch" type="xml">
            <list string="Phân tích Email"
                  decoration-success="prediction == 'safe'"
                  decoration-warning="prediction == 'warning'"
                  decoration-danger="prediction == 'phishing'">

                <field name="name"/>
                <field name="sender"/>
                <field name="recipient_email"/>
                <field name="source" widget="badge"/>
                <field name="received_date"/>
                <field name="prediction" widget="badge"/>
                <field name="risk_score"/>

            </list>
        </field>
    </record>

    <!-- 2. GIAO DIEN CHI TIET EMAIL -->
    <record id="view_email_phishing_check_form" model="ir.ui.view">
        <field name="name">email.phishing.check.form</field>
        <field name="model">email.phishing.check</field>
        <field name="arch" type="xml">
            <form string="Phân tích Email">

                <!-- CAC NUT CHUC NANG -->
                <header>
                    <button
                        name="action_analyze_email"
                        type="object"
                        string="Phân tích email bằng AI"
                        class="oe_highlight"
                    />

                    <button
                        name="action_send_warning_email"
                        type="object"
                        string="Gửi cảnh báo cho người nhận"
                        class="btn-secondary"
                        invisible="prediction == 'pending'"
                    />

                    <field
                        name="prediction"
                        widget="statusbar"
                        statusbar_visible="pending,safe,warning,phishing"
                        readonly="1"
                    />
                </header>

                <sheet>
                    <!-- TIEU DE -->
                    <div class="oe_title">
                        <h1>
                            <field
                                name="name"
                                placeholder="Nhập tiêu đề email..."
                            />
                        </h1>
                    </div>

                    <!-- THONG TIN EMAIL -->
                    <group>
                        <group string="Thông tin email">
                            <field
                                name="sender"
                                placeholder="example@domain.com"
                            />

                            <field
                                name="recipient_email"
                                placeholder="nguoinhan@example.com"
                            />

                            <field name="source" readonly="1"/>
                            <field name="received_date" readonly="1"/>
                            <field name="message_id" readonly="1"/>
                        </group>

                        <group string="Kết quả phân tích AI">
                            <field
                                name="prediction"
                                widget="badge"
                                decoration-success="prediction == 'safe'"
                                decoration-warning="prediction == 'warning'"
                                decoration-danger="prediction == 'phishing'"
                                readonly="1"
                            />

                            <field
                                name="risk_score"
                                widget="percentage"
                                readonly="1"
                            />
                        </group>
                    </group>

                    <!-- NOI DUNG EMAIL -->
                    <notebook>
                        <page string="Nội dung email">
                            <field
                                name="email_body"
                                placeholder="Dán nội dung email cần kiểm tra vào đây..."
                                nolabel="1"
                            />
                        </page>

                        <page string="Hướng dẫn an toàn">
                            <div class="alert alert-success"
                                 role="alert">
                                <strong>AN TOÀN:</strong>
                                Mô hình chưa phát hiện đủ dấu hiệu đáng ngờ.
                                Vẫn cần kiểm tra người gửi và liên kết.
                            </div>

                            <div class="alert alert-warning"
                                 role="alert">
                                <strong>CẢNH BÁO:</strong>
                                Kiểm tra kỹ nội dung, đường dẫn và yêu cầu
                                cung cấp thông tin cá nhân.
                            </div>

                            <div class="alert alert-danger"
                                 role="alert">
                                <strong>NGHI NGỜ LỪA ĐẢO:</strong>
                                Không cung cấp mật khẩu, mã OTP hoặc
                                thông tin ngân hàng cho nguồn chưa xác minh.
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 3. HANH DONG MO DANH SACH EMAIL -->
    <record id="action_email_phishing_check"
            model="ir.actions.act_window">
        <field name="name">Phân tích Email</field>
        <field name="res_model">email.phishing.check</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- 4. MENU CHINH -->
    <menuitem
        id="menu_email_phishing_root"
        name="Email Security"
        sequence="10"
    />

    <!-- 5. MENU PHAN TICH EMAIL -->
    <menuitem
        id="menu_email_phishing_check"
        name="Phân tích Email"
        parent="menu_email_phishing_root"
        action="action_email_phishing_check"
        sequence="1"
    />

    <!-- 6. HÀNH ĐỘNG HÀNG LOẠT: PHÂN TÍCH LẠI BẰNG AI CHO CÁC EMAIL ĐƯỢC CHỌN -->
    <record id="action_server_analyze_bulk_emails" model="ir.actions.server">
        <field name="name">Phân tích lại bằng AI</field>
        <field name="model_id" ref="model_email_phishing_check"/>
        <field name="binding_model_id" ref="model_email_phishing_check"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_analyze_email()</field>
    </record>
</odoo>
